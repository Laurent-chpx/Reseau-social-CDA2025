{% extends 'base.html.twig' %}

{% block title %}Événements | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--events">
        <div class="page__container">
            <div class="page__layout">
                {# ========== SIDEBAR FILTERS ========== #}
                <aside class="filters">
                    <form method="GET" action="{{ path('app_event_index') }}" class="filters__form" id="filters-form">

                        {# Search #}
                        <div class="filters__section">
                            <h3 class="filters__title">Recherche</h3>
                            <input
                                type="text"
                                name="search"
                                class="filters__input"
                                placeholder="Rechercher..."
                                value="{{ currentFilters.search }}"
                            >
                        </div>

                        {# Categories #}
                        <div class="filters__section">
                            <h3 class="filters__title">Catégorie</h3>
                            <div class="filters__options">
                                {% for category in categories %}
                                    <label class="filters__option">
                                        <input
                                            type="radio"
                                            name="category"
                                            value="{{ category.id }}"
                                            {{ currentFilters.category == category.id ? 'checked' : '' }}
                                        >
                                        <span class="filters__label">{{ category.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        {# Dates #}
                        <div class="filters__section">
                            <h3 class="filters__title">Date</h3>
                            <div class="filters__dates">
                                <label class="filters__date-field">
                                    <span class="filters__date-label">Du</span>
                                    <input
                                        type="date"
                                        name="date_from"
                                        class="filters__input"
                                        value="{{ currentFilters.dateFrom }}"
                                    >
                                </label>
                                <label class="filters__date-field">
                                    <span class="filters__date-label">Au</span>
                                    <input
                                        type="date"
                                        name="date_to"
                                        class="filters__input"
                                        value="{{ currentFilters.dateTo }}"
                                    >
                                </label>
                            </div>
                        </div>

                        {# Department #}
                        <div class="filters__section">
                            <h3 class="filters__title">Département</h3>
                            <select name="department" class="filters__select">
                                <option value="">Tous les départements</option>
                                {% for department in departments %}
                                    <option value="{{ department.id }}" {{ currentFilters.department == department.id ? 'selected' : '' }}>
                                        {{ department.code }} - {{ department.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# City #}
                        <div class="filters__section">
                            <h3 class="filters__title">Ville</h3>
                            <select name="city" class="filters__select">
                                <option value="">Toutes les villes</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}" {{ currentFilters.city == city.id ? 'selected' : '' }}>
                                        {{ city.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Free only #}
                        <div class="filters__section">
                            <label class="filters__checkbox">
                                <input
                                    type="checkbox"
                                    name="free_only"
                                    value="1"
                                    {{ currentFilters.freeOnly ? 'checked' : '' }}
                                >
                                <span class="filters__checkbox-label">Événements gratuits uniquement</span>
                            </label>
                        </div>

                        {# Actions #}
                        <div class="filters__actions">
                            <button type="submit" class="btn btn--primary btn--block">Filtrer</button>
                            <a href="{{ path('app_event_index') }}" class="btn btn--outline btn--block">Réinitialiser</a>
                        </div>
                    </form>
                </aside>

                {# ========== EVENTS GRID ========== #}
                <main class="page__content">
                    {% if events is empty %}
                        <div class="empty-state">
                            <div class="empty-state__icon"><i class="fa-regular fa-calendar-days"></i></div>
                            <p class="empty-state__text">Aucun événement trouvé avec ces critères.</p>
                            <a href="{{ path('app_event_index') }}" class="btn btn--outline">Voir tous les événements</a>
                        </div>
                    {% else %}
                        <p class="page__results">
                            {{ events|length }} événement{{ events|length > 1 ? 's' : '' }} trouvé{{ events|length > 1 ? 's' : '' }}
                        </p>

                        <div class="events-grid">
                            {% for event in events %}
                                {% include 'event/_card.html.twig' with {'event': event} %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </main>
            </div>
        </div>
    </div>
{% endblock %}
