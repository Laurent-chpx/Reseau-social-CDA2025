{% extends 'base.html.twig' %}

{% block title %}Événements Locaux | La Vie en Rose{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/logo.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/events-list.css') }}">
{% endblock %}

{% block body %}
    <div class="page-container">
        {# Header Navigation #}
        <header class="main-header">
            {% include '_components/_logo.html.twig' %}
            <nav class="nav-menu">
                <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
                <a href="{{ path('app_event_index') }}" class="nav-link active">Événements</a>
                {% if app.user %}
                    <a href="{{ path('app_profile') }}" class="nav-link">Mon profil</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-link">Connexion</a>
                {% endif %}
            </nav>
        </header>

        {# Main Content #}
        <div class="events-container">
            {# Page Title #}
            <h1 class="page-title">Événements Locaux</h1>

            <div class="content-layout">
                {# Sidebar Filters #}
                <aside class="filters-sidebar">
                    <div class="filter-section">
                        <h3 class="filter-title">Type d'événement</h3>
                        <div class="filter-options">
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="concert">
                                <span class="filter-icon">🎵</span>
                                <span class="filter-label">Concert</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="sport">
                                <span class="filter-icon">⚽</span>
                                <span class="filter-label">Sport</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="nature">
                                <span class="filter-icon">🌳</span>
                                <span class="filter-label">Nature</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="festival">
                                <span class="filter-icon">🎪</span>
                                <span class="filter-label">Festival</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="theatre">
                                <span class="filter-icon">🎭</span>
                                <span class="filter-label">Théâtre</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="conference">
                                <span class="filter-icon">💼</span>
                                <span class="filter-label">Conférence</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="type" value="autre">
                                <span class="filter-icon">📌</span>
                                <span class="filter-label">Autre</span>
                            </label>
                        </div>
                    </div>

                    <div class="filter-section">
                        <h3 class="filter-title">Date</h3>
                        <div class="filter-options">
                            <label class="filter-option">
                                <input type="radio" name="date" value="all" checked>
                                <span class="filter-label">Toutes les dates</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="date" value="today">
                                <span class="filter-label">Aujourd'hui</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="date" value="week">
                                <span class="filter-label">Cette semaine</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="date" value="month">
                                <span class="filter-label">Ce mois-ci</span>
                            </label>
                        </div>
                    </div>

                    <div class="filter-section">
                        <h3 class="filter-title">Localisation</h3>
                        <div class="filter-options">
                            <label class="filter-option">
                                <input type="checkbox" name="location" value="origin">
                                <span class="filter-label">Ville d'origine</span>
                            </label>
                            <label class="filter-option">
                                <input type="checkbox" name="location" value="followed">
                                <span class="filter-label">Par fonction</span>
                            </label>
                        </div>
                    </div>

                    <button class="btn-reset">Annulation</button>
                </aside>

                {# Events Grid #}
                <main class="events-main">
                    {% if events is empty %}
                        <div class="empty-state">
                            <p>Aucun événement disponible pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="events-grid">
                            {% for event in events %}
                                <article class="event-card">
                                    <div class="event-badge">En préparation</div>
                                    <div class="event-image-placeholder">
                                        {% if event.images is not empty and event.images|first.url %}
                                            <img src="{{ asset('uploads/events/' ~ event.images|first.url) }}" alt="{{ event.title }}">
                                        {% else %}
                                            {% set gradients = [
                                                'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                                                'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
                                                'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
                                                'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
                                                'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
                                                'linear-gradient(135deg, #30cfd0 0%, #330867 100%)',
                                                'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
                                                'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)'
                                            ] %}
                                            {% set gradient = gradients[event.id % 8] %}
                                            <div class="gradient-placeholder" style="background: {{ gradient }};">
                                                <div class="placeholder-overlay">
                                                    <span class="placeholder-icon">📅</span>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="event-content">
                                        <h2 class="event-title">{{ event.title }}</h2>
                                        <div class="event-meta">
                                            <p class="event-location">📍 {{ event.city.name }}</p>
                                            <p class="event-date">📅 {{ event.dateStart|date('d/m/Y') }}</p>
                                        </div>
                                        {% if event.description %}
                                            <p class="event-description">{{ event.description|length > 120 ? event.description|slice(0, 120) ~ '...' : event.description }}</p>
                                        {% endif %}
                                        <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn-event">Voir en détails ></a>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>

                        {# Pagination #}
                        <div class="pagination">
                            <button class="btn-pagination btn-prev">Précédent</button>
                            <span class="pagination-info">Page 1 à {{ (events|length / 10)|round(0, 'ceil') }}</span>
                            <button class="btn-pagination btn-next">Suivant</button>
                        </div>
                    {% endif %}
                </main>
            </div>
        </div>

        {# Footer #}
        <footer class="main-footer">
            <p>Liens: <a href="#">A propos</a> / <a href="#">Contact</a> / <a href="#">CGU/Confidentialité</a></p>
            <p>@2025 Réseau Social d'Événements</p>
        </footer>
    </div>
{% endblock %}
