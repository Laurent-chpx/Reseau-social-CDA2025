{% extends 'base.html.twig' %}

{% block title %}Créer une catégorie{% endblock %}

{% block body %}
    <h1>Créer une catégorie</h1>

    {{ form_start(form) }}
    {{ form_row(form.name) }}

    <button type="submit">Créer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_category_index') }}">Retour à la liste</a></p>
{% endblock %}
