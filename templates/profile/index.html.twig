{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | La Vie en Rose{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/logo.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {# Header Navigation #}
        <header class="dashboard-header">
            {% include '_components/_logo.html.twig' %}
            <nav class="dashboard-nav">
                <a href="{{ path('app_event_index') }}" class="nav-link">Événements</a>
                <a href="{{ path('app_profile_events') }}" class="nav-link">Mes événements</a>
            </nav>
            <div class="user-avatar">
                {% if app.user %}
                    {{ app.user.email|first|upper }}{{ app.user.email|slice(app.user.email|split('@')[0]|length - 1, 1)|upper }}
                {% else %}
                    JD
                {% endif %}
            </div>
        </header>

        {# Welcome Section #}
        <section class="welcome-section">
            <h1 class="welcome-title">
                Bonjour {% if app.user %}{{ app.user.email|split('@')[0]|capitalize }}{% else %}Jean{% endif %} !
            </h1>
        </section>

        {# Stats Cards #}
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">{{ eventsCount|default(0) }}</div>
                    <div class="stat-label">Événements créés</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ followersCount|default(0) }}</div>
                    <div class="stat-label">Abonnés</div>
                </div>
            </div>
        </section>

        {# Main Content - Two Columns #}
        <section class="content-section">
            <div class="content-grid">
                {# Left Column - New Events #}
                <div class="content-column">
                    <h2 class="column-title">Nouveaux événements dans vos villes</h2>

                    <div class="events-list">
                        {% if followedCitiesEvents is not empty %}
                            {% for event in followedCitiesEvents %}
                                <div class="event-card-dashboard">
                                    <div class="event-image-placeholder">
                                        {% if event.images|length > 0 %}
                                            <img src="{{ asset('uploads/events/' ~ event.images.first.url) }}" alt="{{ event.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                                        {% else %}
                                            [IMAGE PRINCIPALE]
                                        {% endif %}
                                    </div>
                                    <div class="event-info">
                                        <h3 class="event-title-dashboard">{{ event.title }}</h3>
                                        <p class="event-location-dashboard">📍 {{ event.city.name }}</p>
                                        <p class="event-date-dashboard">📅 {{ event.dateStart|date('d F Y') }}</p>
                                    </div>
                                    <a href="{{ path('app_event_show', {id: event.id}) }}" class="event-btn-dashboard">Voir ></a>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="event-card-dashboard">
                                <div class="event-image-placeholder">[IMAGE PRINCIPALE]</div>
                                <div class="event-info">
                                    <h3 class="event-title-dashboard">Aucun événement</h3>
                                    <p class="event-location-dashboard">📍 Suivez des villes</p>
                                    <p class="event-date-dashboard">📅 Pour voir les événements</p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Right Column - Activity Feed #}
                <div class="content-column">
                    <h2 class="column-title">Vos créateurs favoris ont publié</h2>

                    <div class="activity-feed">
                        {% if followedCreatorsEvents is not empty %}
                            {% for event in followedCreatorsEvents %}
                                <div class="activity-item">
                                    <p class="activity-text">
                                        <strong>{{ event.createdBy.firstName ?? 'Organisateur' }} {{ event.createdBy.lastName ?? '' }}</strong> a publié<br>
                                        <span class="activity-detail">
                                            {{ event.title }} •
                                            {% set diff = date().diff(event.createdAt) %}
                                            {% if diff.d > 1 %}
                                                il y a {{ diff.d }} jours
                                            {% elseif diff.d == 1 %}
                                                Hier
                                            {% elseif diff.h > 0 %}
                                                il y a {{ diff.h }}h
                                            {% else %}
                                                il y a quelques minutes
                                            {% endif %}
                                        </span>
                                    </p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="activity-item">
                                <p class="activity-text">
                                    <strong>Aucune activité récente</strong><br>
                                    <span class="activity-detail">Suivez des organisateurs pour voir leurs publications</span>
                                </p>
                            </div>
                        {% endif %}

                        <a href="{{ path('app_event_index') }}" class="btn-view-all">Voir tous les événements</a>
                    </div>
                </div>
            </div>
        </section>

        {# Create Event Button #}
        <section class="create-event-section">
            <a href="{{ path('app_profile_event_new') }}" class="btn-create-event">Créer un nouvel événement</a>
        </section>
    </div>
{% endblock %}