{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--dashboard">
        <div class="page__container">

            {# ========== WELCOME ========== #}
            <section class="dashboard__welcome">
                <h1 class="dashboard__title">
                    Bonjour {{ app.user.firstName }} ! 👋
                </h1>
                <p class="dashboard__subtitle">Bienvenue sur votre tableau de bord</p>
            </section>

            {# ========== STATS ========== #}
            <section class="dashboard__stats stats-grid">
                <div class="stat-card">
                    <span class="stat-card__value">{{ eventsCount|default(0) }}</span>
                    <span class="stat-card__label">Événements créés</span>
                </div>
                <div class="stat-card">
                    <span class="stat-card__value">{{ followersCount|default(0) }}</span>
                    <span class="stat-card__label">Abonnés</span>
                </div>
                <div class="stat-card">
                    <span class="stat-card__value">{{ app.user.followedCities|length }}</span>
                    <span class="stat-card__label">Villes suivies</span>
                </div>
                <div class="stat-card">
                    <span class="stat-card__value">{{ app.user.following|length }}</span>
                    <span class="stat-card__label">Abonnements</span>
                </div>
            </section>

            {# ========== CONTENT GRID ========== #}
            <div class="dashboard__grid">
                {# Events from followed cities #}
                <section class="dashboard__section">
                    <div class="dashboard__card">
                        <h2 class="dashboard__card-title">Événements dans vos villes</h2>

                        {% if followedCitiesEvents is not empty %}
                            <div class="dashboard__list">
                                {% for event in followedCitiesEvents|slice(0, 5) %}
                                    <a href="{{ path('app_event_show', {id: event.id}) }}" class="dashboard__item">
                                        <div class="dashboard__item-image">
                                            {% if event.images|length > 0 %}
                                                <img src="{{ asset('uploads/events/' ~ event.images|first.url) }}" alt="">
                                            {% else %}
                                                <span class="dashboard__item-placeholder">📅</span>
                                            {% endif %}
                                        </div>
                                        <div class="dashboard__item-info">
                                            <h4 class="dashboard__item-title">{{ event.title }}</h4>
                                            <p class="dashboard__item-meta">
                                                📍 {{ event.city.name }} • 📅 {{ event.dateStart|date('d/m/Y') }}
                                            </p>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="dashboard__empty">
                                <p>Aucun événement dans vos villes suivies</p>
                                <a href="{{ path('app_event_index') }}" class="btn btn--outline btn--sm">Découvrir des événements</a>
                            </div>
                        {% endif %}
                    </div>
                </section>

                {# Activity feed #}
                <section class="dashboard__section">
                    <div class="dashboard__card">
                        <h2 class="dashboard__card-title">Activité de vos abonnements</h2>

                        {% if followedCreatorsEvents is not empty %}
                            <div class="dashboard__feed">
                                {% for event in followedCreatorsEvents|slice(0, 5) %}
                                    <div class="dashboard__feed-item">
                                        <div class="dashboard__feed-avatar avatar">
                                            {{ event.createdBy.firstName|first|upper }}
                                        </div>
                                        <div class="dashboard__feed-content">
                                            <p class="dashboard__feed-text">
                                                <strong>{{ event.createdBy.firstName }} {{ event.createdBy.lastName }}</strong>
                                                a publié
                                            </p>
                                            <a href="{{ path('app_event_show', {id: event.id}) }}" class="dashboard__feed-link">
                                                {{ event.title }}
                                            </a>
                                            <span class="dashboard__feed-date">
                                                {{ event.createdAt|date('d/m/Y') }}
                                            </span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="dashboard__empty">
                                <p>Aucune activité récente</p>
                                <a href="{{ path('app_event_index') }}" class="btn btn--outline btn--sm">Découvrir des organisateurs</a>
                            </div>
                        {% endif %}
                    </div>
                </section>
            </div>

            {# ========== QUICK ACTIONS ========== #}
            <section class="dashboard__actions">
                <a href="{{ path('app_profile_event_new') }}" class="btn btn--primary btn--lg">
                    + Créer un événement
                </a>
                <a href="{{ path('app_profile_events') }}" class="btn btn--outline">
                    Gérer mes événements
                </a>
                <a href="{{ path('app_profile_edit') }}" class="btn btn--outline">
                    Modifier mon profil
                </a>
            </section>
        </div>
    </div>
{% endblock %}
