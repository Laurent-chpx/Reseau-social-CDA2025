{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
    <h1>Mon Dashboard</h1>

    {% for message in app.flashes('success') %}
        <p style="color: green;">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <p style="color: red;">{{ message }}</p>
    {% endfor %}

    <h2>Mes informations</h2>
    <p><strong>Email :</strong> {{ user.email }}</p>
    <p><strong>Prénom :</strong> {{ user.firstName }}</p>
    <p><strong>Nom :</strong> {{ user.lastName }}</p>
    <p><strong>Inscrit le :</strong> {{ user.createdAt|date('d/m/Y') }}</p>
    <p><a href="{{ path('app_profile_edit') }}">Modifier mon profil</a></p>

    <h2>Mes événements ({{ events|length }})</h2>
    <p><a href="{{ path('app_profile_events') }}">Voir tous mes événements</a></p>
    <p><a href="{{ path('app_profile_event_new') }}">+ Créer un événement</a></p>

    <p><a href="{{ path('app_logout') }}">Déconnexion</a></p>
{% endblock %}
