{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--profile-edit">
        <div class="page__container page__container--narrow">
            <h1 class="page__title">Modifier mon profil</h1>

            {{ form_start(form, {'attr': {'class': 'form'}}) }}

            {# ========== PERSONAL INFO ========== #}
            <fieldset class="form__fieldset">
                <legend class="form__legend">Informations personnelles</legend>

                <div class="form__row">
                    <div class="form__group form__group--half">
                        {{ form_label(form.firstName, 'Prénom', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(form.firstName, {'attr': {'class': 'form__input'}}) }}
                        {{ form_errors(form.firstName) }}
                    </div>

                    <div class="form__group form__group--half">
                        {{ form_label(form.lastName, 'Nom', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(form.lastName, {'attr': {'class': 'form__input'}}) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                <div class="form__group">
                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form__label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form__input'}}) }}
                    {{ form_errors(form.email) }}
                </div>
            </fieldset>

            {# ========== CHANGE PASSWORD ========== #}
            <fieldset class="form__fieldset">
                <legend class="form__legend">Modifier le mot de passe</legend>
                <p class="form__help">Laissez vide si vous ne souhaitez pas le modifier</p>

                <div class="form__group">
                    {{ form_label(form.currentPassword, 'Mot de passe actuel', {'label_attr': {'class': 'form__label'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'form__input', 'autocomplete': 'current-password'}}) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <div class="form__row">
                    <div class="form__group form__group--half">
                        {{ form_label(form.plainPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form__input', 'autocomplete': 'new-password'}}) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>

                    <div class="form__group form__group--half">
                        {{ form_label(form.plainPassword.second, 'Confirmer', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form__input', 'autocomplete': 'new-password'}}) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                </div>
            </fieldset>

            {# ========== SUBMIT ========== #}
            <div class="form__actions">
                <a href="{{ path('app_profile') }}" class="btn btn--outline">Annuler</a>
                <button type="submit" class="btn btn--primary">Enregistrer</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
