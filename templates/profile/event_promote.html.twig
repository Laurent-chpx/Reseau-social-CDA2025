{% extends 'base.html.twig' %}

{% block title %}Promouvoir mon événement | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--promote">
        <div class="page__container">

            {# ========== HERO ========== #}
            <section class="promote-hero">
                <h1 class="promote-hero__title">Mettez votre événement en avant ⭐</h1>
                <p class="promote-hero__subtitle">Augmentez votre visibilité et touchez plus de monde !</p>
            </section>

            {# ========== SELECTED EVENT ========== #}
            <section class="promote-event">
                <h2 class="promote-event__title">Événement sélectionné</h2>
                <div class="promote-event__card">
                    <div class="promote-event__image">
                        {% if event.images|length > 0 %}
                            <img src="{{ asset('uploads/events/' ~ event.images|first.url) }}" alt="{{ event.title }}">
                        {% else %}
                            <span class="promote-event__placeholder">📅</span>
                        {% endif %}
                    </div>
                    <div class="promote-event__info">
                        <h3 class="promote-event__name">{{ event.title }}</h3>
                        <p class="promote-event__meta">
                            📍 {{ event.city.name }} ({{ event.city.department.code }}) •
                            📅 {{ event.dateStart|date('d/m/Y') }}
                        </p>
                    </div>
                </div>
            </section>

            {{ form_start(form, {'attr': {'class': 'promote-form', 'id': 'promote-form'}}) }}

            {# Hidden formula field #}
            <div style="display: none;">
                {{ form_widget(form.formula) }}
            </div>

            {# ========== FORMULAS ========== #}
            <section class="promote-formulas">
                <h2 class="promote-formulas__title">Choisissez votre formule</h2>

                <div class="formulas-grid">
                    {% for key, formula in formulas %}
                        <div class="formula-card {{ key == '15_days' ? 'formula-card--popular' : '' }}"
                             data-formula="{{ key }}"
                             data-days="{{ formula.days }}"
                             data-price="{{ formula.price }}">

                            {% if key == '15_days' %}
                                <span class="formula-card__badge">Populaire</span>
                            {% endif %}

                            <h3 class="formula-card__duration">{{ formula.label }}</h3>
                            <p class="formula-card__price">{{ formula.price|number_format(0) }}€</p>
                            <p class="formula-card__description">{{ formula.description }}</p>

                            <ul class="formula-card__features">
                                {% for feature in formula.features %}
                                    <li>✓ {{ feature }}</li>
                                {% endfor %}
                            </ul>

                            <button type="button" class="formula-card__btn btn btn--outline btn--block">
                                Choisir
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# ========== DATE SELECTION ========== #}
            <section class="promote-date" id="date-section">
                <h2 class="promote-date__title">Date de début</h2>
                <p class="promote-date__text">
                    La promotion durera <strong id="selected-days">0</strong> jours à partir de cette date.
                </p>

                <div class="form__group">
                    {{ form_label(form.dateStart, 'Date de début', {'label_attr': {'class': 'form__label'}}) }}
                    {{ form_widget(form.dateStart, {'attr': {'class': 'form__input'}}) }}
                    {{ form_errors(form.dateStart) }}
                </div>
            </section>

            {# ========== SUMMARY ========== #}
            <section class="promote-summary" id="summary">
                <h2 class="promote-summary__title">Récapitulatif</h2>
                <div class="promote-summary__content">
                    <div class="promote-summary__row">
                        <span>Formule</span>
                        <strong id="summary-formula">-</strong>
                    </div>
                    <div class="promote-summary__row">
                        <span>Durée</span>
                        <strong><span id="summary-days">-</span> jours</strong>
                    </div>
                    <div class="promote-summary__row">
                        <span>Période</span>
                        <strong id="summary-period">-</strong>
                    </div>
                    <div class="promote-summary__row promote-summary__row--total">
                        <span>Total</span>
                        <strong><span id="summary-price">0</span> €</strong>
                    </div>
                </div>
            </section>

            {# ========== SUBMIT ========== #}
            <div class="promote-actions">
                <a href="{{ path('app_profile_events') }}" class="btn btn--outline">Annuler</a>
                <button type="submit" class="btn btn--primary btn--lg" id="submit-btn">
                    Envoyer ma demande
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const formulaCards = document.querySelectorAll('.formula-card');
            const formulaInput = document.getElementById('promote_request_form_formula');
            const dateSection = document.getElementById('date-section');
            const dateInput = document.getElementById('promote_request_form_dateStart');
            const summary = document.getElementById('summary');
            const submitBtn = document.getElementById('submit-btn');

            let selectedFormula = null;
            let selectedDays = 0;
            let selectedPrice = 0;

            // Initially hide date and summary
            dateSection.style.display = 'none';
            summary.style.display = 'none';

            formulaCards.forEach(card => {
                card.addEventListener('click', function() {
                    formulaCards.forEach(c => c.classList.remove('formula-card--selected'));
                    this.classList.add('formula-card--selected');

                    selectedFormula = this.dataset.formula;
                    selectedDays = parseInt(this.dataset.days);
                    selectedPrice = parseFloat(this.dataset.price);

                    formulaInput.value = selectedFormula;
                    document.getElementById('selected-days').textContent = selectedDays;

                    dateSection.style.display = 'block';
                    updateSummary();
                });
            });

            if (dateInput) {
                dateInput.addEventListener('change', updateSummary);
            }

            function updateSummary() {
                if (!selectedFormula || !dateInput.value) {
                    summary.style.display = 'none';
                    return;
                }

                const startDate = new Date(dateInput.value);
                const endDate = new Date(startDate);
                endDate.setDate(endDate.getDate() + selectedDays - 1);

                const formatDate = (date) => date.toLocaleDateString('fr-FR');

                document.getElementById('summary-formula').textContent = selectedDays + ' jours';
                document.getElementById('summary-days').textContent = selectedDays;
                document.getElementById('summary-period').textContent = formatDate(startDate) + ' → ' + formatDate(endDate);
                document.getElementById('summary-price').textContent = selectedPrice.toFixed(2);

                summary.style.display = 'block';
            }
        });
    </script>
{% endblock %}
