{% extends 'base.html.twig' %}

{% block title %}Promouvoir mon événement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/logo.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/event-promote.css') }}">
{% endblock %}

{% block body %}
    <div class="page-container">
        {# Main Content #}
        <div class="promote-container">
            {# Hero Section #}
            <section class="hero-section">
                <h1 class="hero-title">Mettez votre événement en avant</h1>
                <p class="hero-subtitle">Augmentez la visibilité de votre événement et touchez plus de monde !</p>
            </section>

            {# Selected Event #}
            <section class="selected-event-section">
                <h2 class="section-title">Événement sélectionné</h2>
                <div class="event-card-preview">
                    <div class="event-image">
                        {% if event.images|length > 0 %}
                            <img src="{{ asset('uploads/events/' ~ event.images.first.url) }}" alt="{{ event.title }}">
                        {% else %}
                            <div class="image-placeholder">[img]</div>
                        {% endif %}
                    </div>
                    <div class="event-details">
                        <h3 class="event-title">{{ event.title }}</h3>
                        <div class="event-info">
                            <p class="event-location">📍 {{ event.city.name }} ({{ event.city.postalCode|slice(0, 2) }})</p>
                            <p class="event-date">📅 {{ event.dateStart|date('d M Y') }}</p>
                        </div>
                    </div>
                </div>
            </section>

            {{ form_start(form, {'attr': {'id': 'promote-form'}}) }}


    </div>

    <div class="formulas-container">
        {% for key, formula in formulas %}
            <div class="formula-card-wrapper">
                {% if key == '15_days' %}
                    <span class="popular-badge">POPULAIRE</span>
                {% endif %}
                <div class="formula-card" data-formula="{{ key }}" data-days="{{ formula.days }}" data-price="{{ formula.price }}">
                    <div class="duration">{{ formula.label }}</div>
                    <div class="price">{{ formula.price|number_format(0) }}€</div>
                    <div class="description">{{ formula.description }}</div>
                    <ul class="features">
                        {% for feature in formula.features %}
                            <li>{{ feature }}</li>
                        {% endfor %}
                    </ul>
                    <button type="button" class="select-btn">Choisir</button>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="date-section" id="date-section">
        <h3>Date de début de la promotion</h3>
        <p>La promotion commencera à cette date et durera <strong id="selected-days">0</strong> jours.</p>
        {{ form_row(form.dateStart) }}
    </div>

    <div class="summary" id="summary">
        <h3>Récapitulatif</h3>
        <p>Formule : <strong id="summary-formula">-</strong></p>
        <p>Durée : <strong id="summary-days">-</strong> jours</p>
        <p>Période : <strong id="summary-period">-</strong></p>
        <p class="total-price">Total : <span id="summary-price">0</span> €</p>
    </div>

    <div style="text-align: center; margin-top: 20px;">
        <button type="submit" class="submit-btn" id="submit-btn">Envoyer ma demande de promotion</button>
    </div>
{% endblock %}
