{% extends 'base.html.twig' %}

{% block title %}Mes demandes de promotion | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--promote-requests">
        <div class="page__container">
            <h1 class="page__title">Mes demandes de promotion</h1>

            {% if requests is empty %}
                <div class="empty-state">
                    <div class="empty-state__icon">⭐</div>
                    <h2 class="empty-state__title">Aucune demande</h2>
                    <p class="empty-state__text">Vous n'avez pas encore fait de demande de promotion.</p>
                    <a href="{{ path('app_profile_events') }}" class="btn btn--primary">Voir mes événements</a>
                </div>
            {% else %}
                <div class="requests-list">
                    {% for request in requests %}
                        <article class="request-card">
                            <div class="request-card__header">
                                <h3 class="request-card__title">
                                    <a href="{{ path('app_event_show', {id: request.event.id}) }}">
                                        {{ request.event.title }}
                                    </a>
                                </h3>

                                <span class="badge {{ request.isPending ? 'badge--warning' : (request.isApproved ? 'badge--success' : 'badge--error') }}">
                                    {% if request.isPending %}
                                        ⏳ En attente
                                    {% elseif request.isApproved %}
                                        ✅ Approuvée
                                    {% else %}
                                        ❌ Refusée
                                    {% endif %}
                                </span>
                            </div>

                            <div class="request-card__content">
                                <div class="request-card__info">
                                    <span class="request-card__detail">
                                        <strong>Formule :</strong> {{ request.formulaLabel }}
                                    </span>
                                    <span class="request-card__detail">
                                        <strong>Période :</strong>
                                        {{ request.dateStart|date('d/m/Y') }} → {{ request.dateEnd|date('d/m/Y') }}
                                    </span>
                                    <span class="request-card__detail">
                                        <strong>Prix :</strong> {{ request.totalPrice|number_format(2, ',', ' ') }} €
                                    </span>
                                </div>

                                <div class="request-card__meta">
                                    <span>Demandé le {{ request.createdAt|date('d/m/Y à H\\hi') }}</span>
                                    {% if request.processedAt %}
                                        <span>Traité le {{ request.processedAt|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>

                                {% if request.adminNote %}
                                    <div class="request-card__note">
                                        <strong>Note de l'administrateur :</strong>
                                        <p>{{ request.adminNote }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="page__back">
                <a href="{{ path('app_profile') }}" class="btn btn--outline">← Retour au tableau de bord</a>
            </div>
        </div>
    </div>
{% endblock %}
