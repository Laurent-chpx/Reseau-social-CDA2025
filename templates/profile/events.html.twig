{% extends 'base.html.twig' %}

{% block title %}Mes événements | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--my-events">
        <div class="page__container">
            <div class="page__header">
                <h1 class="page__title">Mes événements</h1>
                <a href="{{ path('app_profile_event_new') }}" class="btn btn--primary">
                    + Créer un événement
                </a>
            </div>

            {# ========== TABS ========== #}
            <div class="tabs">
                <button class="tabs__btn tabs__btn--active" data-tab="active">
                    Actifs
                    <span class="tabs__count">{{ events|filter(e => e.dateStart >= date())|length }}</span>
                </button>
                <button class="tabs__btn" data-tab="past">
                    Passés
                    <span class="tabs__count">{{ events|filter(e => e.dateStart < date())|length }}</span>
                </button>
            </div>

            {# ========== EVENTS LIST ========== #}
            {% if events is empty %}
                <div class="empty-state">
                    <div class="empty-state__icon">📅</div>
                    <h2 class="empty-state__title">Aucun événement</h2>
                    <p class="empty-state__text">Vous n'avez pas encore créé d'événement.</p>
                    <a href="{{ path('app_profile_event_new') }}" class="btn btn--primary">
                        Créer mon premier événement
                    </a>
                </div>
            {% else %}
                <div class="my-events-grid">
                    {% for event in events %}
                        {% set is_active = event.dateStart >= date() %}
                        {% set is_promoted = event.promote is not null %}

                        <article class="my-event-card" data-status="{{ is_active ? 'active' : 'past' }}">
                            {# Status badge #}
                            <div class="my-event-card__badges">
                                {% if is_active %}
                                    <span class="badge badge--success">Actif</span>
                                {% else %}
                                    <span class="badge badge--muted">Passé</span>
                                {% endif %}
                                {% if is_promoted %}
                                    <span class="badge badge--promoted">⭐ Promu</span>
                                {% endif %}
                            </div>

                            {# Image #}
                            <div class="my-event-card__image">
                                {% if event.images|length > 0 %}
                                    <img src="{{ asset('uploads/events/' ~ event.images|first.url) }}" alt="{{ event.title }}">
                                {% else %}
                                    <div class="my-event-card__placeholder">📅</div>
                                {% endif %}
                            </div>

                            {# Info #}
                            <div class="my-event-card__content">
                                <h3 class="my-event-card__title">{{ event.title }}</h3>

                                <div class="my-event-card__meta">
                                    <span>📍 {{ event.city.name }}</span>
                                    <span>📅 {{ event.dateStart|date('d/m/Y') }}</span>
                                </div>

                                {# Tags #}
                                {% if event.categories is not empty %}
                                    <div class="my-event-card__tags">
                                        {% for category in event.categories|slice(0, 2) %}
                                            <span class="tag tag--sm">{{ category.name }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            {# Actions #}
                            <div class="my-event-card__actions">
                                <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn--outline btn--sm" title="Voir">
                                    👁
                                </a>
                                <a href="{{ path('app_profile_event_edit', {id: event.id}) }}" class="btn btn--outline btn--sm" title="Modifier">
                                    ✏️
                                </a>
                                {% if not is_promoted and is_active %}
                                    <a href="{{ path('app_profile_event_promote', {id: event.id}) }}" class="btn btn--outline btn--sm" title="Promouvoir">
                                        ⭐
                                    </a>
                                {% endif %}
                                <form action="{{ path('app_profile_event_delete', {id: event.id}) }}" method="POST" class="my-event-card__delete">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                    <button type="submit" class="btn btn--danger btn--sm" title="Supprimer" onclick="return confirm('Supprimer cet événement ?')">
                                        🗑
                                    </button>
                                </form>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            {# Back link #}
            <div class="page__back">
                <a href="{{ path('app_profile') }}" class="btn btn--outline">← Retour au tableau de bord</a>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tabs = document.querySelectorAll('.tabs__btn');
            const cards = document.querySelectorAll('.my-event-card');

            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabs.forEach(t => t.classList.remove('tabs__btn--active'));
                    this.classList.add('tabs__btn--active');

                    const filter = this.dataset.tab;
                    cards.forEach(card => {
                        card.style.display = (card.dataset.status === filter) ? 'flex' : 'none';
                    });
                });
            });
        });
    </script>
{% endblock %}
