{% extends 'base.html.twig' %}

{% block title %}Modifier {{ event.title }}{% endblock %}

{% block body %}
    <h1>Modifier l'événement</h1>

    {% for message in app.flashes('success') %}
        <p style="color: green;">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <p style="color: red;">{{ message }}</p>
    {% endfor %}

    {% if event.images|length > 0 %}
        <h2>Images actuelles</h2>
        <div>
            {% for image in event.images %}
                <div style="display: inline-block; margin: 10px; text-align: center;">
                    <img src="{{ asset('uploads/events/' ~ image.url) }}" width="150" alt="Image {{ loop.index }}">
                    <br>
                    <form action="{{ path('app_profile_event_image_delete', {id: image.id}) }}" method="POST" style="margin-top: 5px;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_image' ~ image.id) }}">
                        <button type="submit" onclick="return confirm('Supprimer cette image ?')">Supprimer</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.address) }}
    {{ form_row(form.city) }}
    {{ form_row(form.dateStart) }}
    {{ form_row(form.dateEnd) }}
    {{ form_row(form.schedule) }}
    {{ form_row(form.price) }}
    {{ form_row(form.categories) }}

    <h2>Ajouter de nouvelles images</h2>
    {{ form_row(form.images) }}

    <button class="cta-btn" type="submit">Enregistrer les modifications</button>
    {{ form_end(form) }}

    <p><a class="cta-btn" href="{{ path('app_profile_events') }}">Retour à mes événements</a></p>
{% endblock %}
