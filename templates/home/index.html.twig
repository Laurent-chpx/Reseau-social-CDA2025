{% extends 'base.html.twig' %}

{% block title %}La Vie en Rose - Découvrez les événements près de chez vous{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/accueil.css') }}">
{% endblock %}
{% block body %}

    <section class="hero-section">
        <div class="hero-content">
            <h1>Découvrez les événements<br>près de chez vous</h1>
            <div class="search-container">
                <form action="{{ path('app_event_index') }}" method="GET">
                    <div>

                        {# Champ de recherche texte #}
                        <input type="text" name="search" placeholder="Rechercher un événement...">

                        {# Filtre par catégorie #}
                        <select name="category" >
                            <option value="">Toutes catégories</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>

                        {# Filtre par département #}
                        <select name="department">
                            <option value="">Tous départements</option>
                            {% for department in departments %}
                                <option value="{{ department.id }}">{{ department.code }} - {{ department.name }}</option>
                            {% endfor %}
                        </select>

                        {# Bouton de recherche #}
                        <button type="submit">Rechercher</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section class="events-section">
        <h2 class="section-title">Événements sponsorisés dans votre région</h2>

        <div class="events-grid">
            {% for event in promotedEvents %}
                <div class="event-card">
                    <div class="event-image-container">
                        <span class="sponsored-badge">⭐ SPONSORISÉ</span>
                        <span>
                           {% if event.images|length > 0 %}
                               <img src="{{ asset('uploads/events/' ~ event.images[0].url) }}" alt="{{ event.title }}">
                           {% else %}
                               <img src="{{ asset('images/placeholder.jpg') }}" alt="Pas d'image">
                           {% endif %}
                        </span>
                    </div>
                    <div class="event-details">
                        <h3 class="event-title">{{ event.title }}</h3>
                        <div class="event-location">
                            📍 {{ event.city.name }} ({{ event.city.department.code }})
                        </div>
                        <div class="event-date">
                            📅 {{ event.dateStart|date('d/m/Y à H:i') }}
                        </div>
                        {% for category in event.categories %}
                            <span class="tag">{{ category.name }}</span>
                        {% endfor %}
                        <a href="{{ path('app_event_show', {id: event.id}) }}" class="event-btn">Voir les détails →</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div style="text-align: center;">
            <a href="{{ path('app_event_index') }}" class="view-all-btn">Voir tous les événements</a>
        </div>
    </section>

    <section class="events-section">
        <div class="cta-section">
            <h2>Prêt à découvrir votre prochain événement ?</h2>
            <p>Rejoignez la communauté et ne ratez plus rien près de chez vous</p>
            <a href="{{ path('app_register') }}" class="cta-btn">Créer un compte gratuitement</a>
        </div>
    </section>
{% endblock %}
