{% extends 'base.html.twig' %}

{% block title %}La Vie en Rose - Découvrez les événements près de chez vous{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/accueil.css') }}">
{% endblock %}

{% block body %}
    <section class="hero-section">
        <div class="hero-content">
            <h1>Découvrez les événements<br>près de chez vous</h1>
            <div class="search-container">
                <form action="{{ path('app_event_index') }}" method="GET">
                    <div>
                        <input type="text" name="search" placeholder="Rechercher un événement...">

                        <select name="category">
                            <option value="">Toutes catégories</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>

                        <select name="department" id="department-select">
                            <option value="">Tous départements</option>
                            {% for department in departments %}
                                <option value="{{ department.id }}" data-code="{{ department.code }}">
                                    {{ department.code }} - {{ department.name }}
                                </option>
                            {% endfor %}
                        </select>

                        <button type="submit">Rechercher</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section class="events-section">
        <div class="cta-section">
            <h2>Prêt à découvrir votre prochain événement ?</h2>
            <p>Rejoignez la communauté et ne ratez plus rien près de chez vous</p>
            <a href="{{ path('app_register') }}" class="cta-btn">Créer un compte gratuitement</a>
        </div>
    </section>

    <section class="events-section">
        <h2 class="section-title" id="events-title">Événements près de chez vous</h2>
        <p id="location-info" style="text-align: center; color: #666;"></p>

        <a href="{{ path('app_event_index') }}" class="view-all-btn" style="margin-bottom: 1rem; ">Voir tous les événements</a>
        <div class="events-grid" id="events-container">
            <p id="loading-message" style="text-align: center;">Chargement des événements...</p>
        </div>

        <div style="text-align: center; margin-top: 2rem;">
            <button id="load-more-btn" class="view-all-btn" style="display: none;">
                Afficher plus d'événements
            </button>
            <p id="no-events-message" style="display: none;">Aucun événement trouvé dans votre région</p>
        </div>
    </section>


{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/home.js') }}"></script>
{% endblock %}
