{% extends 'base.html.twig' %}

{% block title %}Découvrez les événements près de chez vous | La Vie en Rose{% endblock %}

{% block body %}
    {# ========== HERO SECTION ========== #}
    <section class="hero">
        <div class="hero__container">
            <h1 class="hero__title">Découvrez les événements<br>près de chez vous</h1>
            <p class="hero__subtitle">Concerts, festivals, expositions... Trouvez votre prochaine sortie</p>

            {# Search Form #}
            <form action="{{ path('app_event_index') }}" method="GET" class="hero__search search-form">
                <div class="search-form__row">
                    <div class="search-form__field">
                        <input
                            type="text"
                            name="search"
                            class="search-form__input"
                            placeholder="Rechercher un événement..."
                        >
                    </div>

                    <div class="search-form__field">
                        <select name="category" class="search-form__select">
                            <option value="">Toutes catégories</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="search-form__field">
                        <select name="department" id="department-select" class="search-form__select">
                            <option value="">Tous départements</option>
                            {% for department in departments %}
                                <option value="{{ department.id }}" data-code="{{ department.code }}">
                                    {{ department.code }} - {{ department.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <button type="submit" class="search-form__submit btn btn--primary">
                        Rechercher
                    </button>
                </div>
            </form>
        </div>
    </section>

    {# ========== CTA SECTION ========== #}
    <section class="cta-section">
        <div class="cta-section__container">
            <h2 class="cta-section__title">Prêt à découvrir votre prochain événement ?</h2>
            <p class="cta-section__text">Rejoignez la communauté et ne ratez plus rien près de chez vous</p>
            {% if not app.user %}
                <a href="{{ path('app_register') }}" class="btn btn--primary btn--lg">Créer un compte gratuitement</a>
            {% else %}
                <a href="{{ path('app_profile_event_new') }}" class="btn btn--primary btn--lg">Créer un événement</a>
            {% endif %}
        </div>
    </section>

    {# ========== EVENTS SECTION ========== #}
    <section class="section section--events">
        <div class="section__container">
            <div class="section__header">
                <h2 class="section__title" id="events-title">Événements près de chez vous</h2>
                <p class="section__location" id="location-info"></p>
            </div>

            <a href="{{ path('app_event_index') }}" class="section__link">Voir tous les événements →</a>

            {# Events Grid - loaded dynamically via JS #}
            <div class="events-grid" id="events-container">
                <p class="events-grid__loading" id="loading-message">Chargement des événements...</p>
            </div>

            {# Load more / No events #}
            <div class="section__actions">
                <button id="load-more-btn" class="btn btn--outline" style="display: none;">
                    Afficher plus d'événements
                </button>
                <p id="no-events-message" class="section__empty" style="display: none;">
                    Aucun événement trouvé dans votre région
                </p>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/home.js') }}"></script>
{% endblock %}
