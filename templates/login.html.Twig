{% extends 'base.html.twig' %}

{% block title %}Connexion | La Vie en Rose{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/connexion.css') }}">
{% endblock %}

{% block body %}
    <div class="page-container">
        {# Header Navigation #}
        <header class="main-header">
            <div class="logo">La Vie<br>en Rose</div>
            <nav class="nav-menu">
                <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
                <a href="{{ path('app_events') }}" class="nav-link">Événements</a>
                <a href="{{ path('app_login') }}" class="nav-link active">Connexion</a>
            </nav>
        </header>

        {# Main Content - Login & Registration Forms #}
        <main class="auth-container">
            <div class="auth-grid">
                {# Login Section #}
                <section class="auth-card">
                    <h2 class="auth-title">Bon retour !</h2>
                    <p class="auth-subtitle">Connectez-vous pour accéder à votre espace personnel</p>

                    <form method="post" class="auth-form">
                        <div class="form-group">
                            <label for="login_email">Email</label>
                            <input
                                type="email"
                                id="login_email"
                                name="_username"
                                class="form-input"
                                placeholder="nom@domaine.com"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="login_password">Mot de passe</label>
                            <input
                                type="password"
                                id="login_password"
                                name="_password"
                                class="form-input"
                                placeholder=""""""""""
                                required
                            >
                        </div>

                        <div class="form-options">
                            <label class="checkbox-container">
                                <input type="checkbox" name="_remember_me">
                                <span class="checkbox-label">Se souvenir de moi</span>
                            </label>
                            <a href="{{ path('app_forgot_password') }}" class="forgot-link">Mot de passe oublié ?</a>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn-primary">Se connecter</button>
                    </form>
                </section>

                {# Registration Section #}
                <section class="auth-card">
                    <h2 class="auth-title">Créer un compte</h2>
                    <p class="auth-subtitle">Rejoignez la communauté gratuitement !</p>

                    <form action="{{ path('app_register') }}" method="post" class="auth-form">
                        <div class="form-group">
                            <label>Type de compte</label>
                            <div class="account-type-selector">
                                <label class="type-option">
                                    <input type="radio" name="account_type" value="particulier" checked>
                                    <span class="type-label">Particulier</span>
                                    <span class="type-description">personnel</span>
                                </label>
                                <label class="type-option">
                                    <input type="radio" name="account_type" value="association">
                                    <span class="type-label">Association</span>
                                    <span class="type-description">organisatrice</span>
                                </label>
                                <label class="type-option">
                                    <input type="radio" name="account_type" value="municipalite">
                                    <span class="type-label">Municipalité</span>
                                    <span class="type-description">collectivité</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="register_name">Nom complet / Organisation</label>
                            <input
                                type="text"
                                id="register_name"
                                name="name"
                                class="form-input"
                                placeholder="Ex. : Jean Dupont"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="register_email">Email</label>
                            <input
                                type="email"
                                id="register_email"
                                name="email"
                                class="form-input"
                                placeholder="nom@domaine.com"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="register_password">Mot de passe</label>
                            <input
                                type="password"
                                id="register_password"
                                name="password"
                                class="form-input"
                                placeholder=""""""""""
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label class="checkbox-container">
                                <input type="checkbox" name="terms" required>
                                <span class="checkbox-label">
                                    J'accepte les <a href="{{ path('app_terms') }}" class="link">Conditions d'utilisation</a> et la <a href="{{ path('app_privacy') }}" class="link">politique de confidentialité</a>
                                </span>
                            </label>
                        </div>

                        <button type="submit" class="btn-primary">Créer mon compte</button>
                    </form>
                </section>
            </div>

            {# Benefits Section #}
            <section class="benefits-section">
                <h3 class="benefits-title">Pourquoi créer un compte ?</h3>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Suivez vos organisateurs favoris</h4>
                        <p class="benefit-description">Restez informé des nouveaux événements de vos associations préférées</p>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Recevez des notifications personnalisées</h4>
                        <p class="benefit-description">Ne manquez plus aucun événement qui vous intéresse</p>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Créez vos propres événements</h4>
                        <p class="benefit-description">Organisez et partagez vos événements avec la communauté</p>
                    </div>
                </div>
            </section>
        </main>
    </div>
{% endblock %}