{% extends 'base.html.twig' %}

{% block title %}Inscription | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--auth">
        <div class="auth">
            <div class="auth__container auth__container--register">

                {# ========== REGISTER FORM ========== #}
                <div class="auth__card auth__card--wide">
                    <h1 class="auth__title">Créer un compte 🌹</h1>
                    <p class="auth__subtitle">Rejoignez la communauté gratuitement !</p>

                    {{ form_start(registrationForm, {'attr': {'class': 'form'}}) }}

                    <div class="form__row">
                        <div class="form__group form__group--half">
                            {{ form_label(registrationForm.firstName, 'Prénom', {'label_attr': {'class': 'form__label'}}) }}
                            {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form__input', 'placeholder': 'Jean'}}) }}
                            {{ form_errors(registrationForm.firstName) }}
                        </div>

                        <div class="form__group form__group--half">
                            {{ form_label(registrationForm.lastName, 'Nom', {'label_attr': {'class': 'form__label'}}) }}
                            {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form__input', 'placeholder': 'Dupont'}}) }}
                            {{ form_errors(registrationForm.lastName) }}
                        </div>
                    </div>

                    <div class="form__group">
                        {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form__input', 'placeholder': 'nom@exemple.com'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form__group">
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'form__label'}}) }}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form__input', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                        <small class="form__help">Minimum 6 caractères</small>
                    </div>

                    <div class="form__group">
                        <label class="form__checkbox">
                            {{ form_widget(registrationForm.agreeTerms) }}
                            <span class="form__checkbox-label">
                                    J'accepte les <a href="#" class="form__link">conditions d'utilisation</a>
                                    et la <a href="#" class="form__link">politique de confidentialité</a>
                                </span>
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">
                        Créer mon compte
                    </button>

                    {{ form_end(registrationForm) }}

                    <div class="auth__footer">
                        <p>Déjà inscrit ? <a href="{{ path('app_login') }}" class="auth__link">Se connecter</a></p>
                    </div>
                </div>

                {# ========== BENEFITS SIDEBAR ========== #}
                <div class="auth__sidebar">
                    <h3 class="auth__sidebar-title">Pourquoi s'inscrire ?</h3>

                    <div class="auth__benefits auth__benefits--vertical">
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">⭐</span>
                            <p>Suivez vos organisateurs favoris</p>
                        </div>
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">🔔</span>
                            <p>Notifications personnalisées</p>
                        </div>
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">📅</span>
                            <p>Créez vos propres événements</p>
                        </div>
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">🌟</span>
                            <p>Participez à la vie locale</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
