<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}La Vie en Rose{% endblock %}</title>

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Vast+Shadow&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

</head>
<body>
{# ========== HEADER ========== #}
<header class="header">
    <div class="header__container">
        <a href="{{ path('app_home') }}" class="header__logo logo">
            <span class="logo__text">La Vie<br>en Rose</span>
        </a>

        <nav class="header__nav nav">
            <a href="{{ path('app_home') }}" class="nav__link">Accueil</a>
            <a href="{{ path('app_event_index') }}" class="nav__link">Événements</a>

            {% if app.user %}
                <div class="nav__user user-menu">
                    <button class="user-menu__trigger" type="button" aria-expanded="false">
                            <span class="user-menu__avatar avatar">
                                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                            </span>
                    </button>

                    <div class="user-menu__dropdown">
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin') }}" class="user-menu__item">Administration</a>
                        {% endif %}
                        <a href="{{ path('app_profile') }}" class="user-menu__item">Mon profil</a>
                        <a href="{{ path('app_profile_events') }}" class="user-menu__item">Mes événements</a>
                        <a href="{{ path('app_my_follows') }}" class="user-menu__item">Mes abonnements</a>
                        <hr class="user-menu__divider">
                        <a href="{{ path('app_logout') }}" class="user-menu__item user-menu__item--logout">Déconnexion</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav__link nav__link--cta btn btn--primary btn--sm">Connexion</a>
            {% endif %}
        </nav>

        {# Mobile menu toggle #}
        <button class="header__mobile-toggle" type="button" aria-label="Menu">
            <span class="hamburger"></span>
        </button>
    </div>
</header>

{# ========== MAIN CONTENT ========== #}
<main class="main">
    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert--{{ label }}">
                <span class="alert__message">{{ message }}</span>
                <button class="alert__close" type="button" aria-label="Fermer">&times;</button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{# ========== FOOTER ========== #}
<footer class="footer">
    <div class="footer__container">
        <div class="footer__links">
            <a href="#" class="footer__link">À propos</a>
            <a href="#" class="footer__link">Contact</a>
            <a href="#" class="footer__link">CGU / Confidentialité</a>
        </div>
        <p class="footer__copyright">&copy; {{ "now"|date("Y") }} La Vie en Rose - Réseau Social d'Événements</p>
    </div>
</footer>
{% block javascripts %}{% endblock %}

</body>
</html>
