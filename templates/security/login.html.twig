{% extends 'base.html.twig' %}

{% block title %}Connexion | La Vie en Rose{% endblock %}

{% block body %}
    <div class="page page--auth">
        <div class="auth">
            <div class="auth__container">

                {# ========== LOGIN FORM ========== #}
                <div class="auth__card">
                    <h1 class="auth__title">Bon retour ! 👋</h1>
                    <p class="auth__subtitle">Connectez-vous pour accéder à votre espace</p>

                    {% if error %}
                        <div class="alert alert--error">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}" class="form">
                        <div class="form__group">
                            <label for="inputEmail" class="form__label">Email</label>
                            <input
                                type="email"
                                name="email"
                                id="inputEmail"
                                class="form__input"
                                value="{{ last_username }}"
                                placeholder="nom@exemple.com"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>

                        <div class="form__group">
                            <label for="inputPassword" class="form__label">Mot de passe</label>
                            <input
                                type="password"
                                name="password"
                                id="inputPassword"
                                class="form__input"
                                placeholder="••••••••"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <div class="form__row form__row--between">
                            <label class="form__checkbox">
                                <input type="checkbox" name="_remember_me">
                                <span class="form__checkbox-label">Se souvenir de moi</span>
                            </label>
                            <a href="#" class="form__link">Mot de passe oublié ?</a>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn--primary btn--block">
                            Se connecter
                        </button>
                    </form>

                    <div class="auth__footer">
                        <p>Pas encore de compte ? <a href="{{ path('app_register') }}" class="auth__link">S'inscrire</a></p>
                    </div>
                </div>

                {# ========== INFO CARD ========== #}
                <div class="auth__info">
                    <h2 class="auth__info-title">Nouveau sur La Vie en Rose ?</h2>
                    <p class="auth__info-text">Rejoignez notre communauté pour profiter de tous les avantages</p>

                    <div class="auth__benefits">
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">⭐</span>
                            <div class="auth__benefit-content">
                                <h4>Suivez vos organisateurs favoris</h4>
                                <p>Restez informé des nouveaux événements</p>
                            </div>
                        </div>
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">🔔</span>
                            <div class="auth__benefit-content">
                                <h4>Notifications personnalisées</h4>
                                <p>Ne manquez plus aucun événement</p>
                            </div>
                        </div>
                        <div class="auth__benefit">
                            <span class="auth__benefit-icon">📅</span>
                            <div class="auth__benefit-content">
                                <h4>Créez vos événements</h4>
                                <p>Partagez vos activités avec la communauté</p>
                            </div>
                        </div>
                    </div>

                    <a href="{{ path('app_register') }}" class="btn btn--outline btn--block">
                        Créer un compte
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
