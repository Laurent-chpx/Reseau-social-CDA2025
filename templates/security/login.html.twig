{% extends 'base.html.twig' %}

{% block title %}Connexion | La Vie en Rose{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/connexion.css') }}">
{% endblock %}

{% block body %}
    <div class="page-container">
        {# Main Content - Login & Registration Forms #}
        <main class="auth-container">
            <div class="auth-grid">
                {# Login Section #}
                <section class="auth-card">
                    <h2 class="auth-title">Bon retour !</h2>
                    <p class="auth-subtitle">Connectez-vous pour accéder à votre espace personnel</p>

                    {% if error %}
                        <div class="alert alert-error">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}" class="auth-form">
                        <div class="form-group">
                            <label for="inputEmail">Email</label>
                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="email"
                                id="inputEmail"
                                class="form-input"
                                placeholder="nom@domaine.com"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>

                        <div class="form-group">
                            <label for="inputPassword">Mot de passe</label>
                            <input
                                type="password"
                                name="password"
                                id="inputPassword"
                                class="form-input"
                                placeholder="••••••••"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <div class="form-options">
                            <label class="checkbox-container">
                                <input type="checkbox" name="_remember_me">
                                <span class="checkbox-label">Se souvenir de moi</span>
                            </label>
                            <a href="#" class="forgot-link">Mot de passe oublié ?</a>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn-primary">Se connecter</button>
                    </form>
                </section>

                {# Registration Section #}
                <section class="auth-card">
                    <h2 class="auth-title">Nouveau sur La Vie en Rose ?</h2>
                    <p class="auth-subtitle">Rejoignez notre communauté pour profiter de tous les avantages</p>

                    <div class="registration-preview">
                        <h3>Types de compte disponibles :</h3>
                        <ul class="account-types-list">
                            <li><strong>Particulier</strong> - Compte personnel pour suivre et participer aux événements</li>
                            <li><strong>Association</strong> - Compte organisateur pour créer et gérer des événements</li>
                            <li><strong>Municipalité</strong> - Compte collectivité pour promouvoir des événements locaux</li>
                        </ul>
                        <div style="text-align: center; margin-top: 1.5rem;">
                            <a href="{{ path('app_register') }}" class="btn-primary">Créer un compte</a>
                        </div>
                    </div>
                </section>
            </div>

            {# Benefits Section #}
            <section class="benefits-section">
                <h3 class="benefits-title">Pourquoi créer un compte ?</h3>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Suivez vos organisateurs favoris</h4>
                        <p class="benefit-description">Restez informé des nouveaux événements de vos associations préférées</p>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Recevez des notifications personnalisées</h4>
                        <p class="benefit-description">Ne manquez plus aucun événement qui vous intéresse</p>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                            </svg>
                        </div>
                        <h4 class="benefit-title">Créez vos propres événements</h4>
                        <p class="benefit-description">Organisez et partagez vos événements avec la communauté</p>
                    </div>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
