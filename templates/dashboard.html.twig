{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | La Vie en Rose{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/logo.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        {# Header Navigation #}
        <header class="dashboard-header">
            <a href="{{ path('app_home') }}" class="dashboard-logo">
                La Vie<br>en Rose
            </a>
            <nav class="dashboard-nav">
                <a href="{{ path('app_event_index') }}" class="nav-link">Événements</a>
                <a href="" class="nav-link">Mes événements</a>
            </nav>
            <div class="user-avatar">
                {% if app.user %}
                    {{ app.user.email|first|upper }}{{ app.user.email|slice(app.user.email|split('@')[0]|length - 1, 1)|upper }}
                {% else %}
                    JD
                {% endif %}
            </div>
        </header>

        {# Welcome Section #}
        <section class="welcome-section">
            <h1 class="welcome-title">
                Bonjour {% if app.user %}{{ app.user.email|split('@')[0]|capitalize }}{% else %}Jean{% endif %} !
            </h1>
        </section>

        {# Stats Cards #}
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">{{ user_events_count|default(17) }}</div>
                    <div class="stat-label">Événements créés</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ user_subscribers_count|default(240) }}</div>
                    <div class="stat-label">Abonnées</div>
                </div>
            </div>
        </section>

        {# Main Content - Two Columns #}
        <section class="content-section">
            <div class="content-grid">
                {# Left Column - New Events #}
                <div class="content-column">
                    <h2 class="column-title">Nouveaux événements dans vos villes</h2>

                    <div class="events-list">
                        {% for event in recent_events|default([
                            {
                                'title': 'Concert de jazz',
                                'location': 'Parc Montpellier',
                                'date': '22 novembre 2025'
                            },
                            {
                                'title': 'Concert de jazz',
                                'location': 'Parc Montpellier',
                                'date': '22 novembre 2025'
                            }
                        ]) %}
                        <div class="event-card-dashboard">
                            <div class="event-image-placeholder">
                                [IMAGE PRINCIPALE]
                            </div>
                            <div class="event-info">
                                <h3 class="event-title-dashboard">{{ event.title }}</h3>
                                <p class="event-location-dashboard">📍 {{ event.location }}</p>
                                <p class="event-date-dashboard">📅 {{ event.date }}</p>
                            </div>
                            <a href="#" class="event-btn-dashboard">Voir ></a>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                {# Right Column - Activity Feed #}
                <div class="content-column">
                    <h2 class="column-title">Vos créateurs favoris ont publié</h2>

                    <div class="activity-feed">
                        {% for activity in activities|default([
                            {
                                'creator': 'Mairie de Toulouse',
                                'event': 'Festival de printemps',
                                'time': 'il y a 2h'
                            },
                            {
                                'creator': 'Association Sports',
                                'event': 'Marathon urbain',
                                'time': 'il y a 8h'
                            },
                            {
                                'creator': 'Club Photo Montpellier',
                                'event': 'Exposition photos',
                                'time': 'Hier'
                            }
                        ]) %}
                        <div class="activity-item">
                            <p class="activity-text">
                                <strong>{{ activity.creator }}</strong> a publié<br>
                                <span class="activity-detail">{{ activity.event }} • {{ activity.time }}</span>
                            </p>
                        </div>
                        {% endfor %}

                        <a href="{{ path('app_event_index') }}" class="btn-view-all">Voir tous les événements</a>
                    </div>
                </div>
            </div>
        </section>

        {# Create Event Button #}
        <section class="create-event-section">
            <a href="{{ path('app_event_new') }}" class="btn-create-event">Créer un nouvel événement</a>
        </section>
    </div>
{% endblock %}